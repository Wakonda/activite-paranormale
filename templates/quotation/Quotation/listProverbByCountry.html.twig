{% extends "content_layout.html.twig" %}

{% block title %}{{ "quotation.index.Proverb"|trans([], "validators") }} - {{ country.title }}{% endblock %}
{% block h2_title %}<h2><span class="float-start"><img src="{{ asset(country.getAssetImagePath()) }}{{ country.flag }}" alt="" width="20" height="13"></span>{{ "quotation.index.Proverb"|trans([], "validators") }} - {{ country.title }}</h2>{% endblock h2_title %}

{% block header_plus %}
	<link rel="stylesheet" href="{{ asset('extended/js/DataTables/media/css/dataTables.bootstrap5.min.css') }}" type="text/css" media="screen">
	<link rel="stylesheet" href="{{ asset('extended/js/simple-datatable/simple-datatable.min.css') }}">
{% endblock %}

{% block footer_script %}
	<script src="{{ asset('extended/js/simple-datatable/simple-datatable.min.js') }}"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			new SimpleDataTable('table.doc_datatables', {
			  language: { url: "{{ asset('extended/js/simple-datatable/language/dataTables.'~app.request.locale~'.txt') }}" },
			  searching: true,
			  info: false,
			  ordering: true,
			  responsive: true,
			  lengthChange: true,
			  pageLength: {{ total_line_display }},
			  order: [[ 0, "desc" ]],
			  processing: true,
			  ajax: {
				url: "{{ path('Proverb_listProverbByCountryDatatables', { countryId: country.id }) }}",
				type: 'GET'
			  }
			});
		});
	</script>
{% endblock %}

{% block APBlog_body %}
	<p class="image"><img class="image_wrapper mx-auto d-block img-fluid" src="{{ asset('extended/photo/angel-proverb.jpg') }}" alt="Angel AI" width="550"></p>
	<hr>
	<table class="doc_datatables dt-responsive w-100">
		<thead>
			<tr>
				<th class="label_form">{{ "quotation.list.Proverb"|trans([], "validators") }}</th>
				<th class="label_form">{{ "quotation.list.Read"|trans([], "validators") }}</th>
			</tr>
		</thead>
		<tbody>
		</tbody>
		<tfoot>
			<tr>
				<th class="label_form">{{ "quotation.list.Proverb"|trans([], "validators") }}</th>
				<th class="label_form">{{ "quotation.list.Read"|trans([], "validators") }}</th>
			</tr>
		</tfoot>
	</table>
	<br>
	<br>
	<hr class="hr2">
	{{ "google"|advertisement|raw }}
{% endblock %}