{% extends "content_layout.html.twig" %}

{% block title %}{{ "photo.index.Photo"|trans([], "validators") }} - {{ themeDisplay }}{% endblock %}
{% block h2_title %}<h2><span class="float-start"><img src="{{ asset('extended/photo/bat-icon.png') }}" width="30" class="mt-1" alt="Bat"></span>{{ "photo.index.Photo"|trans([], "validators") }} - {{ themeDisplay }}</h2>{% endblock h2_title %}

{% block header_plus %}
	<link rel="stylesheet" href="{{ asset('extended/js/DataTables/media/css/dataTables.bootstrap5.min.css') }}" type="text/css" media="screen">
	<link rel="stylesheet" href="{{ asset('extended/js/simple-datatable/simple-datatable.min.css') }}">
{% endblock %}

{% block footer_script %}
	<script src="{{ asset('extended/js/simple-datatable/simple-datatable.min.js') }}"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const dt = new SimpleDataTable('table.doc_datatables', {
			  language: { url: "{{ asset('extended/js/simple-datatable/language/dataTables.'~app.request.locale~'.txt') }}" },
			  searching: true,
			  info: false,
			  ordering: true,
			  responsive: true,
			  lengthChange: true,
			  pageLength: {{ total_line_display }},
			  processing: true,
			  order: [[2, "desc"]],
			  ajax: {
				url: "{{ path('Photo_TabPictureDatatables', { 'themeId' : themeId }) }}",
				type: 'GET'
			  }
			});
		});
	</script>
{% endblock %}

{% block APBlog_body %}
	<p class="image"><img class="image_wrapper mx-auto d-block img-fluid" src="{{ asset('extended/photo/photo-tab.jpg') }}" alt="Werewolf" width="550"></p>
	<hr>
	<table class="doc_datatables dt-responsive w-100">
		<thead>
			<tr>
				<th class="label_form">{{ "photo.tab.Photo"|trans([], "validators") }}</th>
				<th class="label_form">{{ "photo.tab.Title"|trans([], "validators") }}</th>
				<th class="label_form">{{ "photo.tab.PublicationDate"|trans([], "validators") }}</th>
			</tr>
		</thead>
		<tbody>
		</tbody>
		<tfoot>
			<tr>
				<th class="label_form">{{ "photo.tab.Photo"|trans([], "validators") }}</th>
				<th class="label_form">{{ "photo.tab.Title"|trans([], "validators") }}</th>
				<th class="label_form">{{ "photo.tab.PublicationDate"|trans([], "validators") }}</th>
			</tr>
		</tfoot>
	</table>
	<br>
	<hr class="hr2">
	{{ "google"|advertisement|raw }}
{% endblock %}