{% macro icon(theme) %}
{% apply spaceless %}
	{% set icons = {'event': 'bomb', 'birth': 'birthday-cake', 'death': 'skull-crossbones', 'celebration': 'glass-cheers', 'convention': 'user-tie', 'horoscope': 'meteor', 'saint': 'bible', festival: 'headphones-simple', saying: 'snowflake', news: 'newspaper'} %}
	{% if icons[theme] is defined %}{{ icons[theme] }}{% endif %}
{% endapply %}
{% endmacro %}