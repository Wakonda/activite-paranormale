{% extends "content_layout.html.twig" %}

{% block title %}{{ "directory.index.Annuaire"|trans([], "validators") }}{% endblock %}

{% block h2_title %}
	<h2><span class="float-start"><img src="{{ asset('extended/photo/blue-monster.png') }}" width="25" class="mt-1" alt="Blue monster"></span>{{ "directory.index.Annuaire"|trans([], "validators") }}</h2>
{% endblock h2_title %}

{% block header_plus %}
	<link rel="stylesheet" href="{{ asset('extended/js/DataTables/media/css/dataTables.bootstrap5.min.css') }}" type="text/css" media="screen">
	<link rel="stylesheet" href="{{ asset('extended/js/simple-datatable/simple-datatable.min.css') }}">
{% endblock %}

{% block footer_script %}
	<script src="{{ asset('extended/js/simple-datatable/simple-datatable.min.js') }}"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			new SimpleDataTable('table.index_directories', {
			  language: { url: "{{ asset('extended/js/simple-datatable/language/dataTables.'~app.request.locale~'.txt') }}" },
			  searching: true,
			  info: false,
			  ordering: true,
			  responsive: true,
			  lengthChange: true,
			  pageLength: {{ total_line_display }},
			  processing: true,
			  order: [[ 1, "asc" ]],
			  ajax: {
				url: "{{ path('WebDirectory_SearchDatatables') }}",
				type: 'GET'
			  },
			  columnDefs: [{target: 0, orderable: false},{target: 2,orderable: false},{target: 3,orderable: false}]
			});
		});
	</script>
{% endblock %}

{% block APBlog_body %}
	<div class="alert alert-info">{{ ("directory.index.Promote"|trans({'%start_link%': '<b><u><a href="'~path('WebDirectory_User_New')~'" class="alert-link">', '%end_link%': '</a></u></b>'}, "validators"))|raw }}</div>
	<p class="image"><img class="image_wrapper fl_image mx-auto d-block img-fluid" src="{{ asset('extended/photo/') }}webdirectory.jpg" width="550" alt="Woman Zombie"></p>
	<br>
	<hr class="hr2">
	<table class="index_directories dt-responsive w-100">
		<thead>
			<tr>
				<th>{{ "directory.index.Logo"|trans([], "validators") }}</th>
				<th>{{ "directory.index.Title"|trans([], "validators") }}</th>
				<th>{{ "directory.index.Language"|trans([], "validators") }}</th>
				<th>{{ "directory.index.Link"|trans([], "validators") }}</th>
			</tr>
		</thead>
		<tbody>
		</tbody>
		<tfoot>
			<tr>
				<th>{{ "directory.index.Logo"|trans([], "validators") }}</th>
				<th>{{ "directory.index.Title"|trans([], "validators") }}</th>
				<th>{{ "directory.index.Language"|trans([], "validators") }}</th>
				<th>{{ "directory.index.Link"|trans([], "validators") }}</th>
			</tr>
		</tfoot>
	</table>
	<br>
	<br>
	<br>
	<hr class="hr2">
	{{ "google"|advertisement|raw }}
{% endblock %}